# Base URL the frontend uses to reach the FastAPI backend.
# Local: http://localhost:8000 (or whatever port your local backend runs on)
# Production (Phase 19): set this as a Vercel project environment variable
# to your deployed Render backend's URL, e.g.
# https://dailytechlearn-backend.onrender.com — never commit a real
# production URL here; this file only documents the variable name.
VITE_API_BASE_URL=http://localhost:8000
