# Copy this file to .env and fill in values as needed.
# The backend loads this automatically via python-dotenv (see backend/app/config.py).
#
# Phase 19: this same set of variables is what production (Render) needs —
# see README.md's "Deploying to production" section. Production values are
# set directly in Render's dashboard/render.yaml, NEVER in a committed file.

# --- Used in Phase 1 ---
# Comma-separated list of frontend origins allowed to call the API.
# Local: http://localhost:5173
# Production: your Vercel URL(s), e.g. https://dailytechlearn.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Used in Phase 2 ---
# Connection string for the app's PostgreSQL database.
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Use a dedicated app role (not the postgres superuser) — see README.md.
# Production: point this at a SEPARATE, dedicated production Postgres
# instance (e.g. Render Postgres, Neon, Supabase) — never at this same
# local development database.
DATABASE_URL=postgresql://dailytechlearn_app:your-password-here@localhost:5432/dailytechlearn

# --- Used in Phase 6 (optional) ---
# Dev.to's public articles API needs no API key. Override only if needed
# (e.g. pointing at a mock server in tests).
# DEV_TO_API_BASE_URL=https://dev.to/api

# --- Used in Phase 8 ---
# Groq API key (get one free at https://console.groq.com/keys).
# NEVER commit a real value here — this file only documents the variable name.
GROQ_API_KEY=
# Model to use for generating learning content. See docs/architecture.md for why.
GROQ_MODEL=openai/gpt-oss-20b

# --- Used in Phase 14 ---
# Secret key used to sign/verify login JWTs. Required — the app will not
# start without it. Anyone who has this value can forge a valid login
# token, so treat it like a password: never commit a real value, never
# share it, never print it.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
